{
  "tests": {
    "BusinessExt test": [
      {
        "method": "sendMessage",
        "requestKeys": [
          "business_connection_id",
          "chat_id",
          "text"
        ],
        "request": {
          "text": "test",
          "chat_id": -1000000000002,
          "business_connection_id": "test"
        },
        "status": 400,
        "contentType": "application/json",
        "json": {
          "ok": false,
          "error_code": 400,
          "description": "Bad Request: business connection not found"
        }
      }
    ],
    "InlineExt test": [
      {
        "method": "editMessageText",
        "requestKeys": [
          "entities",
          "inline_message_id",
          "text"
        ],
        "request": {
          "text": "test",
          "entities": [
            {
              "type": "bold",
              "offset": 0,
              "length": 5
            }
          ],
          "inline_message_id": "test"
        },
        "status": 400,
        "contentType": "application/json",
        "json": {
          "ok": false,
          "error_code": 400,
          "description": "Bad Request: invalid inline message identifier specified"
        }
      }
    ]
  }
}
