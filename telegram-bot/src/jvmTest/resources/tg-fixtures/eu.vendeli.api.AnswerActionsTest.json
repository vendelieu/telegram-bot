{
  "tests": {
    "answer callback query test": [
      {
        "method": "answerCallbackQuery",
        "requestKeys": [
          "callback_query_id"
        ],
        "request": {
          "callback_query_id": "test"
        },
        "status": 400,
        "contentType": "application/json",
        "json": {
          "ok": false,
          "error_code": 400,
          "description": "Bad Request: query is too old and response timeout expired or query ID is invalid"
        }
      }
    ],
    "answer inline query test": [
      {
        "method": "answerInlineQuery",
        "requestKeys": [
          "inline_query_id",
          "results"
        ],
        "request": {
          "inline_query_id": "test",
          "results": [
            {
              "type": "photo",
              "id": "testPhoto",
              "photo_url": "https://test.com",
              "thumbnail_url": "https://test.com"
            }
          ]
        },
        "status": 400,
        "contentType": "application/json",
        "json": {
          "ok": false,
          "error_code": 400,
          "description": "Bad Request: query is too old and response timeout expired or query ID is invalid"
        }
      }
    ],
    "answer pre checkout query test": [
      {
        "method": "answerPreCheckoutQuery",
        "requestKeys": [
          "error_message",
          "ok",
          "pre_checkout_query_id"
        ],
        "request": {
          "pre_checkout_query_id": "test",
          "ok": false,
          "error_message": "test1"
        },
        "status": 400,
        "contentType": "application/json",
        "json": {
          "ok": false,
          "error_code": 400,
          "description": "Bad Request: query is too old and response timeout expired or query ID is invalid"
        }
      },
      {
        "method": "answerPreCheckoutQuery",
        "requestKeys": [
          "ok",
          "pre_checkout_query_id"
        ],
        "request": {
          "pre_checkout_query_id": "test",
          "ok": true
        },
        "status": 400,
        "contentType": "application/json",
        "json": {
          "ok": false,
          "error_code": 400,
          "description": "Bad Request: query is too old and response timeout expired or query ID is invalid"
        }
      }
    ],
    "answer shipping query test": [
      {
        "method": "answerShippingQuery",
        "requestKeys": [
          "ok",
          "shipping_options",
          "shipping_query_id"
        ],
        "request": {
          "shipping_query_id": "test",
          "ok": true,
          "shipping_options": [
            {
              "id": "testOp",
              "title": "testTitle",
              "prices": [
                {
                  "label": "testLbl",
                  "amount": 1
                }
              ]
            }
          ]
        },
        "status": 400,
        "contentType": "application/json",
        "json": {
          "ok": false,
          "error_code": 400,
          "description": "Bad Request: query is too old and response timeout expired or query ID is invalid"
        }
      },
      {
        "method": "answerShippingQuery",
        "requestKeys": [
          "ok",
          "shipping_options",
          "shipping_query_id"
        ],
        "request": {
          "shipping_query_id": "test",
          "ok": true,
          "shipping_options": [
            {
              "id": "testOp",
              "title": "testTitle",
              "prices": [
                {
                  "label": "testLbl",
                  "amount": 1
                }
              ]
            }
          ]
        },
        "status": 400,
        "contentType": "application/json",
        "json": {
          "ok": false,
          "error_code": 400,
          "description": "Bad Request: query is too old and response timeout expired or query ID is invalid"
        }
      },
      {
        "method": "answerShippingQuery",
        "requestKeys": [
          "error_message",
          "ok",
          "shipping_options",
          "shipping_query_id"
        ],
        "request": {
          "shipping_query_id": "test",
          "ok": false,
          "shipping_options": [],
          "error_message": "test"
        },
        "status": 400,
        "contentType": "application/json",
        "json": {
          "ok": false,
          "error_code": 400,
          "description": "Bad Request: there must be at least one shipping option"
        }
      }
    ],
    "answer web app query test": [
      {
        "method": "answerWebAppQuery",
        "requestKeys": [
          "result",
          "web_app_query_id"
        ],
        "request": {
          "web_app_query_id": "test",
          "result": {
            "type": "photo",
            "id": "testPhoto",
            "photo_url": "https://test.com",
            "thumbnail_url": "https://test.com"
          }
        },
        "status": 400,
        "contentType": "application/json",
        "json": {
          "ok": false,
          "error_code": 400,
          "description": "Bad Request: query is too old and response timeout expired or query ID is invalid"
        }
      }
    ]
  }
}
